# ── Messenger bot ───────────────────────────────────────────────────────────
MESSENGER_API_URL=https://your-messenger-api.com/send_text
MESSENGER_TOKEN=your_token_here
RECIPIENT_ID=your_recipient_id

# ── Git 저장소 설정 ──────────────────────────────────────────────────────────
# Bitbucket 저장소를 clone한 로컬 경로
GIT_REPO_PATH=/path/to/your/cloned/repo

# 머지 커밋을 조회할 브랜치 (보통 main 또는 master)
GIT_BRANCH=main

# fetch 대상 remote 이름 (기본: origin)
GIT_REMOTE=origin

# ── Perforce 설정 ─────────────────────────────────────────────────────────────
# Perforce 서버 주소 (host:port)
P4PORT=localhost:1666

# Perforce 사용자명
P4USER=your_p4_user

# Perforce 클라이언트(워크스페이스) 이름 — 'p4 client'로 미리 생성 필요
P4CLIENT=your_p4_client

# Perforce 비밀번호 (p4 login 티켓 사용 시 비워도 됨)
P4PASSWD=

# 파일을 제출할 depot 경로 (기본: //depot)
# 예: //depot/myproject
P4DEPOT_BASE=//depot

# ── 상태 파일 ────────────────────────────────────────────────────────────────
# 이미 제출된 머지 커밋을 기록하는 JSON 파일 경로
STATE_FILE=submitted_prs.json
