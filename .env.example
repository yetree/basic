# ── Messenger bot ───────────────────────────────────────────────────────────
MESSENGER_API_URL=https://your-messenger-api.com/send_text
MESSENGER_TOKEN=your_token_here
RECIPIENT_ID=your_recipient_id

# ── Bitbucket ────────────────────────────────────────────────────────────────
# Base API URL (default: https://api.bitbucket.org/2.0)
BITBUCKET_URL=https://api.bitbucket.org/2.0

# Bitbucket workspace slug (e.g. "mycompany")
BITBUCKET_WORKSPACE=your_workspace

# Repository slug inside the workspace (e.g. "my-repo")
BITBUCKET_REPO_SLUG=your_repo_slug

# Bitbucket account username
BITBUCKET_USERNAME=your_bitbucket_username

# Bitbucket App Password (Settings → App passwords, needs PR read permission)
BITBUCKET_APP_PASSWORD=your_app_password

# ── Perforce ─────────────────────────────────────────────────────────────────
# Perforce server address (host:port)
P4PORT=localhost:1666

# Perforce username
P4USER=your_p4_user

# Perforce client/workspace name (must be pre-created with 'p4 client')
P4CLIENT=your_p4_client

# Perforce password (leave empty if using tickets / p4 login)
P4PASSWD=your_p4_password

# Base depot path where files will be submitted (default: //depot)
P4DEPOT_BASE=//depot

# ── State file ───────────────────────────────────────────────────────────────
# JSON file used to track which PRs have already been submitted
STATE_FILE=submitted_prs.json
